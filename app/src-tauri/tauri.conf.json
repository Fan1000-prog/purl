{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Purl",
  "version": "0.9.0",
  "identifier": "app.purl.desktop",
  "build": {
    "beforeDevCommand": "npm run fetch-llama && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run fetch-llama && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Purl",
        "width": 900,
        "height": 640,
        "resizable": true
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "Purl Voice",
        "width": 420,
        "height": 100,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "acceptFirstMouse": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgxMTdENUYwMkI0N0NFMTYKUldRV3prY3I4TlVYZ1ppcUlJSmhOZ0ZGS1pJOXRmM0tNMEZuOTRGOXRsOElQZGdBTzk5QnJwRHcK",
      "endpoints": [
        "https://github.com/Fan1000-prog/purl/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": {
      "vendor/llama/": "llama/"
    },
    "macOS": {
      "signingIdentity": "Purl Self-Signed",
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
